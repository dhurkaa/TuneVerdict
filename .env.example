# Copy this file to .env.local and put your key there. .env.local is git-ignored.
#
# Server-side only. NEVER rename these with a VITE_ prefix: Vite copies VITE_*
# variables into the browser bundle, which would publish the key to every visitor.
#
# On Vercel, set the same variables under Project → Settings → Environment Variables.

OPENAI_API_KEY=
# Optional; defaults to gpt-5.5
OPENAI_MODEL=

# Alternative: used only when OPENAI_API_KEY is empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
